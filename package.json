{
    "name": "pict-section-audio",
    "version": "1.0.2",
    "description": "Pict audio player section — a bespoke audio player (titled header, optional peaks waveform, play/seek/time/volume/rate/download) that scrubs over native HTTP Range. Standalone, or driven as the audio renderer inside pict-section-fileview.",
    "main": "source/Pict-Section-Audio.js",
    "scripts": {
        "start": "node source/Pict-Section-Audio.js",
        "build": "npx quack build",
        "test": "npx quack test",
        "tests": "npx quack test -g",
        "coverage": "npx quack coverage",
        "docs": "npx quack prepare-docs ./docs -d ./modules",
        "docs-serve": "npx quack docs-serve ./docs",
        "example": "npx quack examples",
        "example-serve": "npx quack examples-serve"
    },
    "quackageExamples": {
        "mode": "static"
    },
    "files": [
        "source"
    ],
    "directories": {
        "test": "test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fable-retold/pict-section-audio.git"
    },
    "author": "steven velozo <steven@velozo.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/fable-retold/pict-section-audio/issues"
    },
    "homepage": "https://github.com/fable-retold/pict-section-audio#readme",
    "devDependencies": {
        "browser-env": "^3.3.0",
        "chai": "^4.3.0",
        "pict": "^1.0.372",
        "quackage": "^1.3.0"
    },
    "mocha": {
        "diff": true,
        "extension": [
            "js"
        ],
        "package": "./package.json",
        "reporter": "spec",
        "slow": "75",
        "timeout": "5000",
        "ui": "tdd",
        "watch-files": [
            "source/**/*.js",
            "test/**/*.js"
        ]
    },
    "dependencies": {
        "pict-view": "^1.0.68"
    }
}
